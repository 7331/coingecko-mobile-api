# Every setting is optional; the defaults are what the CLI ships with.
COINGECKO_LOG_LEVEL=WARNING

# API client
COINGECKO_API_BASE_URL=https://mobile-api.coingecko.com
COINGECKO_API_USER_AGENT=CoinGecko/3.29.1.437 CFNetwork/1331.0.7 Darwin/21.4.0 (iPad iPadOS/15.4)
COINGECKO_API_REQUEST_TIMEOUT_SECONDS=15
COINGECKO_API_CONNECTION_RETRY_COUNT=2
COINGECKO_API_FAILURE_ATTEMPT_COUNT=3

# Coin lookup cache (the fuzzy BTC -> bitcoin index)
COINGECKO_LOOKUP_CACHE_DIRECTORY=~/.cache/coingecko-mobile-api
COINGECKO_LOOKUP_CACHE_TTL_SECONDS=3600
COINGECKO_LOOKUP_INDEX_SIZE=300
